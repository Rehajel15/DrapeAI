# Copy this file to .env and fill in the values.

# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me

# Comma-separated list of hostnames Django may serve.
# Add your PC's LAN IP (ipconfig) to reach the backend from a phone with Expo Go.
ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated list of browser origins allowed to call the API (Expo web runs on port 8081)
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
